<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox stylesheets="@styles.css" prefHeight="420.0" prefWidth="500.0" spacing="20.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <HBox alignment="CENTER_LEFT">
        <children>
            <Label text="🔗 Lier un artiste" style="-fx-font-family: 'Segoe UI', sans-serif; -fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
        </children>
    </HBox>

    <Separator style="-fx-background-color: #E5E7EB; -fx-padding: 0;" />

    <VBox spacing="18.0" VBox.vgrow="ALWAYS">
        <children>

            <VBox spacing="6.0">
                <children>
                    <Label text="Contrat" style="-fx-font-weight: bold; -fx-text-fill: #374151; -fx-font-size: 12px;" />
                    <HBox alignment="CENTER_LEFT">
                        <children>
                            <Hyperlink fx:id="hyperText" onAction="#onFileSelector" text="📁 Importer un document" style="-fx-text-fill: #2563EB; -fx-font-weight: bold; -fx-font-family: 'Segoe UI', sans-serif; -fx-font-size: 13px; -fx-underline: false;" />
                        </children>
                    </HBox>
                </children>
            </VBox>

            <VBox spacing="6.0">
                <children>
                    <Label text="Prix*" style="-fx-font-weight: bold; -fx-text-fill: #374151; -fx-font-size: 12px;" />
                    <TextField fx:id="price" promptText="Montant en € (ex: 1500)" maxWidth="1.7976931348623157E308" />
                </children>
            </VBox>

        </children>
    </VBox>

    <Separator style="-fx-background-color: #E5E7EB; -fx-padding: 0;" />

    <HBox alignment="CENTER_RIGHT" spacing="12.0">
        <children>
            <Button mnemonicParsing="false" onAction="#onBackClick" text="Retour" style="-fx-background-color: #F3F4F6; -fx-text-fill: #6B7280; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 10px 20px; -fx-border-color: #D1D5DB; -fx-border-width: 1px; -fx-border-radius: 6px; -fx-cursor: hand; -fx-font-family: 'Segoe UI', sans-serif; -fx-font-size: 12px;" />
            <Button mnemonicParsing="false" onAction="#handleAdd" text="Lier" style="-fx-background-color: #10B981; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 10px 20px; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(16, 185, 129, 0.2), 6, 0, 0, 2); -fx-font-family: 'Segoe UI', sans-serif; -fx-font-size: 12px;" />
        </children>
    </HBox>
</VBox>