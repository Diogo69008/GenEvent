<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="borderPane" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">

    <top>
    </top>

    <left>
        <VBox maxWidth="220.0" minWidth="220.0" prefWidth="220.0" styleClass="sidebar" stylesheets="@styles.css">
            <padding>
                <Insets bottom="24.0" left="0.0" right="0.0" top="0.0" />
            </padding>
            <children>

                <VBox fx:id="g" alignment="CENTER" styleClass="sidebar-brand-banner">
                    <VBox.margin>
                        <Insets top="16.0" left="12.0" right="12.0" bottom="8.0" />
                    </VBox.margin>
                    <padding>
                        <Insets bottom="20.0" left="16.0" right="16.0" top="20.0" />
                    </padding>
                    <children>
                        <Label styleClass="sidebar-tag" style="-fx-text-fill: rgba(255, 255, 255, 0.75);" text="OUTDOOR FESTIVAL" />
                        <Label styleClass="sidebar-title" style="-fx-text-fill: #FFFFFF;" text="🎵 MUSIC" />
                    </children>
                </VBox>

                <VBox fx:id="button_container" spacing="4.0" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets bottom="16.0" left="12.0" right="12.0" top="16.0" />
                    </padding>
                    <children>
                        <Label styleClass="nav-section-label" text="NAVIGATION" />

                        <Button fx:id="dashboard_home" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onHomePageSwitch" styleClass="sidebar-btn, active" text="  🏠   Dashboard" />
                        <Button fx:id="dashboard_agenda" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onAgendaPageSwitch" styleClass="sidebar-btn" text="  📅   Agenda" />
                        <Button fx:id="dashboard_lieu" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onLieuxPageSwitch" styleClass="sidebar-btn" text="  📍   Lieux" />
                        <Button fx:id="dashboard_artiste" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onArtistePageSwitch" styleClass="sidebar-btn" text="  🤝   Artistes" />
                        <Button fx:id="dashboard_prestataire" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onPrestatairePageSwitch" styleClass="sidebar-btn" text="  📦   Prestataires" />
                    </children>
                </VBox>

                <VBox alignment="CENTER">
                    <padding>
                        <Insets bottom="0" left="12.0" right="12.0" top="0" />
                    </padding>
                    <children>
                        <Separator styleClass="sidebar-separator" />
                        <Label styleClass="sidebar-footer" text="Ctrl+Fest">
                            <VBox.margin>
                                <Insets top="12.0" />
                            </VBox.margin>
                        </Label>
                    </children>
                </VBox>

            </children>
        </VBox>
    </left>

    <center>
    </center>

    <right>
    </right>

    <bottom>
    </bottom>
</BorderPane>