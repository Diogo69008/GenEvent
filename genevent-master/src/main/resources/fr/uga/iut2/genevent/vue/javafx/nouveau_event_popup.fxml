<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="550.0" prefWidth="550.0" spacing="20.0" style="-fx-background-color: #FFFFFF;" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <HBox alignment="CENTER_LEFT">
        <children>
            <Label style="-fx-font-family: 'Segoe UI', sans-serif; -fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111827;" text="➕ Créer un nouvel évènement" />
        </children>
    </HBox>

    <Separator style="-fx-background-color: #E5E7EB; -fx-padding: 0;" />

    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
        <VBox fillWidth="true" spacing="18.0">

            <VBox spacing="6.0">
                <Label style="-fx-font-weight: bold; -fx-text-fill: #374151; -fx-font-size: 12px;" text="Nom de l'évènement*" />
                <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label style="-fx-text-fill: #6B7280; -fx-font-size: 11px; -fx-font-style: italic;" text="Le nom du terrain ne pourra plus être modifié." />
                    <TextField fx:id="tfNom" maxWidth="1.7976931348623157E308" onKeyTyped="#verifyField" promptText="Ex: Festival Summer 2026" />
                </VBox>
                <Label fx:id="tfNomError" style="-fx-font-family: 'Segoe UI', sans-serif; -fx-font-size: 11px; -fx-text-fill: #DC2626; -fx-padding: 2px 0 0 0;" />
            </VBox>

            <VBox spacing="6.0">
                <Label style="-fx-font-weight: bold; -fx-text-fill: #374151; -fx-font-size: 12px;" text="Date de début*" />
                <DatePicker fx:id="dpDeb" maxWidth="1.7976931348623157E308" />
                <Label fx:id="dpDebError" style="-fx-font-family: 'Segoe UI', sans-serif; -fx-font-size: 11px; -fx-text-fill: #DC2626; -fx-padding: 2px 0 0 0;" />
            </VBox>

            <VBox spacing="6.0">
                <Label style="-fx-font-weight: bold; -fx-text-fill: #374151; -fx-font-size: 12px;" text="Date de fin*" />
                <DatePicker fx:id="dpFin" maxWidth="1.7976931348623157E308" />
                <Label fx:id="dpFinError" style="-fx-font-family: 'Segoe UI', sans-serif; -fx-font-size: 11px; -fx-text-fill: #DC2626; -fx-padding: 2px 0 0 0;" />
            </VBox>

            <VBox spacing="6.0">
                <Label style="-fx-font-weight: bold; -fx-text-fill: #374151; -fx-font-size: 12px;" text="Lieu" />
                <ComboBox fx:id="cbLieu" maxWidth="1.7976931348623157E308" promptText="Aucun" />
                <Button fx:id="btnLieu" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleNewLieu" style="-fx-background-color: #E0F2FE; -fx-text-fill: #2563EB; -fx-font-weight: bold; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 8px 12px; -fx-cursor: hand; -fx-font-family: 'Segoe UI', sans-serif; -fx-font-size: 12px;" text="+ Nouveau lieu" />
                <Label fx:id="cbLieuError" style="-fx-font-family: 'Segoe UI', sans-serif; -fx-font-size: 11px; -fx-text-fill: #DC2626; -fx-padding: 2px 0 0 0;" />
                <Label fx:id="labErr" style="-fx-font-family: 'Segoe UI', sans-serif; -fx-font-size: 12px; -fx-text-fill: #F59E0B;" />
            </VBox>

            <VBox spacing="6.0">
                <Label style="-fx-font-weight: bold; -fx-text-fill: #374151; -fx-font-size: 12px;" text="Budget*" />
                <TextField fx:id="tfBud" maxWidth="1.7976931348623157E308" onKeyTyped="#verifyField" promptText="Montant en €" />
                <Label fx:id="tfBudError" style="-fx-font-family: 'Segoe UI', sans-serif; -fx-font-size: 11px; -fx-text-fill: #DC2626; -fx-padding: 2px 0 0 0;" />
            </VBox>
        </VBox>
    </ScrollPane>

    <Separator style="-fx-background-color: #E5E7EB; -fx-padding: 0;" />

    <HBox alignment="CENTER_RIGHT" spacing="12.0">
        <children>
            <Button mnemonicParsing="false" onAction="#onResetClick" style="-fx-background-color: #F3F4F6; -fx-text-fill: #6B7280; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 10px 20px; -fx-border-color: #D1D5DB; -fx-border-width: 1px; -fx-border-radius: 6px; -fx-cursor: hand; -fx-font-family: 'Segoe UI', sans-serif; -fx-font-size: 12px;" text="Réinitialiser" />
            <Button mnemonicParsing="false" onAction="#onBackClick" style="-fx-background-color: #F3F4F6; -fx-text-fill: #6B7280; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 10px 20px; -fx-border-color: #D1D5DB; -fx-border-width: 1px; -fx-border-radius: 6px; -fx-cursor: hand; -fx-font-family: 'Segoe UI', sans-serif; -fx-font-size: 12px;" text="Annuler" />
            <Button mnemonicParsing="false" onAction="#handleAjouterClique" style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 10px 20px; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(37, 99, 235, 0.2), 6, 0, 0, 2); -fx-font-family: 'Segoe UI', sans-serif; -fx-font-size: 12px;" text="Créer l'évènement" />
        </children>
    </HBox>
</VBox>
