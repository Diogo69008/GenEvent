<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="650.0" prefWidth="550.0" spacing="25.0" style="-fx-background-color: #FFFFFF;" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <HBox alignment="CENTER_LEFT">
        <children>
            <Label style="-fx-font-family: 'Segoe UI', sans-serif; -fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #111827;" text="📋 Détails de l'évènement" />
        </children>
    </HBox>

    <Separator style="-fx-background-color: #E5E7EB; -fx-padding: 0;" />

    <GridPane hgap="20.0" vgap="16.0" VBox.vgrow="ALWAYS">
        <columnConstraints>
            <ColumnConstraints halignment="LEFT" hgrow="NEVER" minWidth="120.0" prefWidth="120.0" />
            <ColumnConstraints halignment="LEFT" hgrow="ALWAYS" />
        </columnConstraints>

        <rowConstraints>
            <RowConstraints minHeight="36.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="36.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="36.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="36.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="36.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="36.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="130.0" prefHeight="130.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="130.0" prefHeight="130.0" vgrow="SOMETIMES" />
        </rowConstraints>

        <Label style="-fx-font-weight: bold; -fx-text-fill: #374151; -fx-font-size: 14px;" text="Nom" />
        <TextField disable="true" fx:id="nom" maxWidth="Infinity" style="-fx-background-color: #F9FAFB; -fx-border-color: #E5E7EB; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 8px 12px; -fx-text-fill: #111827; -fx-opacity: 1.0;" text="Label" GridPane.columnIndex="1" />

        <Label style="-fx-font-weight: bold; -fx-text-fill: #374151; -fx-font-size: 14px;" text="Date de début" GridPane.rowIndex="1" />
        <TextField disable="true" fx:id="dateDebut" maxWidth="Infinity" style="-fx-background-color: #F9FAFB; -fx-border-color: #E5E7EB; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 8px 12px; -fx-text-fill: #111827; -fx-opacity: 1.0;" text="Label" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label style="-fx-font-weight: bold; -fx-text-fill: #374151; -fx-font-size: 14px;" text="Date de fin" GridPane.rowIndex="2" />
        <TextField disable="true" fx:id="dateFin" maxWidth="Infinity" style="-fx-background-color: #F9FAFB; -fx-border-color: #E5E7EB; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 8px 12px; -fx-text-fill: #111827; -fx-opacity: 1.0;" text="Label" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <Label style="-fx-font-weight: bold; -fx-text-fill: #374151; -fx-font-size: 14px;" text="Lieu" GridPane.rowIndex="3" />
        <TextField disable="true" fx:id="lieu" maxWidth="Infinity" style="-fx-background-color: #F9FAFB; -fx-border-color: #E5E7EB; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 8px 12px; -fx-text-fill: #111827; -fx-opacity: 1.0;" text="Label" GridPane.columnIndex="1" GridPane.rowIndex="3" />

        <Label style="-fx-font-weight: bold; -fx-text-fill: #374151; -fx-font-size: 14px;" text="Budget" GridPane.rowIndex="4" />
        <TextField disable="true" fx:id="budget" maxWidth="Infinity" style="-fx-background-color: #F9FAFB; -fx-border-color: #E5E7EB; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 8px 12px; -fx-text-fill: #111827; -fx-opacity: 1.0;" text="Label" GridPane.columnIndex="1" GridPane.rowIndex="4" />

        <Label style="-fx-font-weight: bold; -fx-text-fill: #374151; -fx-font-size: 14px;" text="Prix du billet" GridPane.rowIndex="5" />
        <Label fx:id="prixBillet" maxWidth="Infinity" style="-fx-background-color: #F9FAFB; -fx-border-color: #E5E7EB; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 8px 12px; -fx-text-fill: #111827; -fx-font-weight: normal;" text="Label" GridPane.columnIndex="1" GridPane.rowIndex="5" />

        <Label style="-fx-font-weight: bold; -fx-text-fill: #374151; -fx-font-size: 14px;" text="Artistes" GridPane.rowIndex="6" />
        <ScrollPane fitToWidth="true" prefHeight="130.0" style="-fx-background-color: #F9FAFB; -fx-background: #F9FAFB; -fx-border-color: #E5E7EB; -fx-border-radius: 6px; -fx-background-radius: 6px;" GridPane.columnIndex="1" GridPane.rowIndex="6">
            <content>
                <VBox fx:id="vboxA" fillWidth="true" spacing="6.0" style="-fx-padding: 10px;" />
            </content>
        </ScrollPane>

        <Label style="-fx-font-weight: bold; -fx-text-fill: #374151; -fx-font-size: 14px;" text="Prestataires" GridPane.rowIndex="7" />
        <ScrollPane fitToWidth="true" prefHeight="130.0" style="-fx-background-color: #F9FAFB; -fx-background: #F9FAFB; -fx-border-color: #E5E7EB; -fx-border-radius: 6px; -fx-background-radius: 6px;" GridPane.columnIndex="1" GridPane.rowIndex="7">
            <content>
                <VBox fx:id="vboxP" fillWidth="true" spacing="6.0" style="-fx-padding: 10px;" />
            </content>
        </ScrollPane>
    </GridPane>

    <Region VBox.vgrow="NEVER" />

    <Separator style="-fx-background-color: #E5E7EB; -fx-padding: 0;" />

    <HBox alignment="CENTER_RIGHT" spacing="12.0">
        <children>
            <Button mnemonicParsing="false" onAction="#handleDeleteClick" style="-fx-background-color: #EF4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 10px 20px; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(239, 68, 68, 0.2), 6, 0, 0, 2);" text="Supprimer" />
            <Region HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#onBackClick" style="-fx-background-color: #F3F4F6; -fx-text-fill: #6B7280; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 10px 20px; -fx-border-color: #D1D5DB; -fx-border-width: 1px; -fx-border-radius: 6px; -fx-cursor: hand;" text="Retour" />
            <Button mnemonicParsing="false" onAction="#handleModifClick" style="-fx-background-color: #10B981; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 10px 20px; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(16, 185, 129, 0.2), 6, 0, 0, 2);" text="Modifier" />
        </children>
    </HBox>

</VBox>