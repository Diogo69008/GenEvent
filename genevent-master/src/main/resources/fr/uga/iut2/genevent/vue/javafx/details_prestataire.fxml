<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefWidth="550.0" spacing="25.0" style="-fx-background-color: #FFFFFF;" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <HBox alignment="CENTER_LEFT">
        <children>
            <Label style="-fx-font-family: 'Segoe UI', sans-serif; -fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111827;" text="🤝 Détails du prestataire" />
        </children>
    </HBox>

    <Separator style="-fx-background-color: #E5E7EB; -fx-padding: 0;" />

    <GridPane hgap="15.0" vgap="16.0">
        <columnConstraints>
            <ColumnConstraints halignment="LEFT" hgrow="NEVER" minWidth="100.0" prefWidth="130.0" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" />
        </columnConstraints>

        <Label style="-fx-font-weight: bold; -fx-text-fill: #374151;" text="Prestataire" />
        <TextField fx:id="LabelNom" disable="true" GridPane.columnIndex="1" />

        <Label style="-fx-font-weight: bold; -fx-text-fill: #374151;" text="Mail" GridPane.rowIndex="1" />
        <TextField fx:id="LabelMail" disable="true" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label style="-fx-font-weight: bold; -fx-text-fill: #374151;" text="Téléphone" GridPane.rowIndex="2" />
        <TextField fx:id="LabelTel" disable="true" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <Label style="-fx-font-weight: bold; -fx-text-fill: #374151;" text="Type" GridPane.rowIndex="3" />
        <TextField fx:id="LabelType" disable="true" GridPane.columnIndex="1" GridPane.rowIndex="3" />

        <Label style="-fx-font-weight: bold; -fx-text-fill: #374151;" text="Informations" GridPane.rowIndex="4" GridPane.valignment="TOP">
            <GridPane.margin>
                <Insets top="8.0" />
            </GridPane.margin>
        </Label>
        <TextField fx:id="LabelInfo" disable="true" GridPane.columnIndex="1" GridPane.rowIndex="4" />

        <rowConstraints>
            <RowConstraints minHeight="30.0" prefHeight="30.0" />
            <RowConstraints minHeight="30.0" prefHeight="30.0" />
            <RowConstraints minHeight="30.0" prefHeight="30.0" />
            <RowConstraints minHeight="30.0" prefHeight="30.0" />
            <RowConstraints minHeight="100.0" prefHeight="100.0" />
        </rowConstraints>
    </GridPane>

    <Region VBox.vgrow="ALWAYS" />

    <Separator style="-fx-background-color: #E5E7EB; -fx-padding: 0;" />

    <HBox alignment="CENTER_RIGHT" spacing="12.0">
        <children>
            <Button fx:id="btnSupprimer" mnemonicParsing="false" onAction="#onBtnSupprimerClick" style="-fx-background-color: #EF4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 10px 20px; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(239, 68, 68, 0.2), 6, 0, 0, 2);" text="Supprimer" />
            <Region HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#onBackClick" style="-fx-background-color: #F3F4F6; -fx-text-fill: #6B7280; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 10px 20px; -fx-border-color: #D1D5DB; -fx-border-width: 1px; -fx-border-radius: 6px; -fx-cursor: hand;" text="Retour" />
            <Button fx:id="btnModifie" onAction="#onModifClick" style="-fx-background-color: #10B981; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 10px 20px; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(16, 185, 129, 0.2), 6, 0, 0, 2);" text="Modifier" />
        </children>
    </HBox>

</VBox>
