<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox stylesheets="@styles.css" prefWidth="550.0" spacing="25.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <HBox alignment="CENTER_LEFT">
        <children>
            <Label text="🎤 Ajouter un artiste" style="-fx-font-family: 'Segoe UI', sans-serif; -fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
        </children>
    </HBox>

    <Separator style="-fx-background-color: #E5E7EB; -fx-padding: 0;" />

    <GridPane hgap="15.0" vgap="16.0">
        <columnConstraints>
            <ColumnConstraints halignment="LEFT" hgrow="NEVER" maxWidth="130.0" minWidth="100.0" prefWidth="130.0" />
            <ColumnConstraints hgrow="ALWAYS" maxWidth="330.0" minWidth="200.0" prefWidth="280.0" />
        </columnConstraints>

        <Label style="-fx-font-weight: bold; -fx-text-fill: #374151;" text="Nom de scène*" />
        <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <Label style="-fx-text-fill: #6B7280; -fx-font-size: 11px; -fx-font-style: italic;" text="Le nom de l'artiste ne pourra plus être modifié." />
            <TextField fx:id="tfNomS" onKeyTyped="#verifyField" promptText="Pseudonym">
                <VBox.margin>
                    <Insets />
                </VBox.margin></TextField>
        </VBox>

        <Label text="Nom*" style="-fx-font-weight: bold; -fx-text-fill: #374151;" GridPane.rowIndex="1" />
        <TextField fx:id="tfNom" onKeyTyped="#verifyField" GridPane.columnIndex="1" GridPane.rowIndex="1" promptText="Nom de famille" />

        <Label text="Prénom*" style="-fx-font-weight: bold; -fx-text-fill: #374151;" GridPane.rowIndex="2" />
        <TextField fx:id="tfPrenom" onKeyTyped="#verifyField" GridPane.columnIndex="1" GridPane.rowIndex="2" promptText="Prénom" />

        <Label text="Âge*" style="-fx-font-weight: bold; -fx-text-fill: #374151;" GridPane.rowIndex="3" />
        <TextField fx:id="tfAge" onKeyTyped="#verifyField" GridPane.columnIndex="1" GridPane.rowIndex="3" promptText="Age de l'artiste" />

        <Label text="Téléphone*" style="-fx-font-weight: bold; -fx-text-fill: #374151;" GridPane.rowIndex="4" />
        <TextField fx:id="tfTel" onKeyTyped="#verifyField" GridPane.columnIndex="1" GridPane.rowIndex="4" promptText="+33 6 XX XX XX XX" />

        <Label text="Informations" style="-fx-font-weight: bold; -fx-text-fill: #374151; -fx-padding: 0 0 0 0;" GridPane.rowIndex="5" GridPane.valignment="TOP">
            <GridPane.margin>
                <Insets top="8.0" />
            </GridPane.margin>
        </Label>
        <TextArea fx:id="taInfo" onKeyTyped="#verifyField" prefRowCount="3" promptText="Bio, genre musical, prix, etc." wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="5" />

        <rowConstraints>
            <RowConstraints />
            <RowConstraints minHeight="35.0" prefHeight="35.0" />
            <RowConstraints minHeight="35.0" prefHeight="35.0" />
            <RowConstraints minHeight="35.0" prefHeight="35.0" />
            <RowConstraints minHeight="35.0" prefHeight="35.0" />
            <RowConstraints minHeight="100.0" prefHeight="100.0" />
        </rowConstraints>
    </GridPane>

    <Region VBox.vgrow="ALWAYS" />

    <Separator style="-fx-background-color: #E5E7EB; -fx-padding: 0;" />

    <HBox alignment="CENTER_RIGHT" spacing="12.0">
        <children>
            <Button mnemonicParsing="false" onAction="#onResetClick" style="-fx-background-color: #F3F4F6; -fx-text-fill: #6B7280; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 10px 20px; -fx-border-color: #D1D5DB; -fx-border-width: 1px; -fx-border-radius: 6px; -fx-cursor: hand;" text="Réinitialiser" />
            <Button mnemonicParsing="false" onAction="#onBackClick" style="-fx-background-color: #F3F4F6; -fx-text-fill: #6B7280; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 10px 20px; -fx-border-color: #D1D5DB; -fx-border-width: 1px; -fx-border-radius: 6px; -fx-cursor: hand;" text="Annuler" />
            <Button mnemonicParsing="false" onAction="#handleAjouterClique" style="-fx-background-color: #F59E0B; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 10px 20px; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(245, 158, 11, 0.2), 6, 0, 0, 2);" text="Ajouter l'artiste" />
        </children>
    </HBox>

</VBox>