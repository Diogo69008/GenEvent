<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox stylesheets="@styles.css"  prefWidth="550.0" spacing="25.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <HBox alignment="CENTER_LEFT">
        <children>
            <Label text="📍 Ajouter un lieu" style="-fx-font-family: 'Segoe UI', sans-serif; -fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
        </children>
    </HBox>

    <Separator style="-fx-background-color: #E5E7EB; -fx-padding: 0;" />

    <GridPane hgap="15.0" vgap="16.0">
        <columnConstraints>
            <ColumnConstraints halignment="LEFT" hgrow="NEVER" minWidth="100.0" prefWidth="130.0" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" />
        </columnConstraints>

        <Label text="Nom*" style="-fx-font-weight: bold; -fx-text-fill: #374151;" GridPane.rowIndex="0" />
        <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <Label style="-fx-text-fill: #6B7280; -fx-font-size: 11px; -fx-font-style: italic;" text="Le nom du terrain ne pourra plus être modifié." />
            <TextField fx:id="nom" onKeyTyped="#verifyField" promptText="Terrain Grenoble">
                <VBox.margin>
                    <Insets bottom="20.0" />
                </VBox.margin></TextField>
        </VBox>

        <Label text="Adresse*" style="-fx-font-weight: bold; -fx-text-fill: #374151;" GridPane.rowIndex="1" />
        <TextField fx:id="adresse" onKeyTyped="#verifyField" promptText="00 Avenue de l'Exemple, 38000 Grenoble" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label text="Superficie*" style="-fx-font-weight: bold; -fx-text-fill: #374151;" GridPane.rowIndex="2" />
        <TextField fx:id="superficie" onKeyTyped="#verifyField" promptText="1 hectare" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <Label text="Capacité" style="-fx-font-weight: bold; -fx-text-fill: #374151;" GridPane.rowIndex="3" />
        <Label fx:id="capacite" text="Aucune" GridPane.columnIndex="1" GridPane.rowIndex="3" />

        <Label text="Description" style="-fx-font-weight: bold; -fx-text-fill: #374151;" GridPane.rowIndex="4" GridPane.valignment="TOP">
            <GridPane.margin>
                <Insets top="8.0" />
            </GridPane.margin>
        </Label>
        <TextArea fx:id="description" onKeyTyped="#verifyField" prefRowCount="3" promptText="Description du lieu et de l'emplacement" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="4" />

        <rowConstraints>
            <RowConstraints minHeight="35.0" prefHeight="35.0" />
            <RowConstraints minHeight="35.0" prefHeight="35.0" />
            <RowConstraints minHeight="35.0" prefHeight="35.0" />
            <RowConstraints minHeight="35.0" prefHeight="35.0" />
            <RowConstraints minHeight="100.0" prefHeight="100.0" />
        </rowConstraints>
    </GridPane>

    <Region VBox.vgrow="ALWAYS" />

    <Separator style="-fx-background-color: #E5E7EB; -fx-padding: 0;" />

    <HBox alignment="CENTER_RIGHT" spacing="12.0">
        <children>
            <Button mnemonicParsing="false" onAction="#onResetClick" style="-fx-background-color: #F3F4F6; -fx-text-fill: #6B7280; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 10px 20px; -fx-border-color: #D1D5DB; -fx-border-width: 1px; -fx-border-radius: 6px; -fx-cursor: hand;" text="Réinitialiser" />
            <Button mnemonicParsing="false" onAction="#onBackClick" style="-fx-background-color: #F3F4F6; -fx-text-fill: #6B7280; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 10px 20px; -fx-border-color: #D1D5DB; -fx-border-width: 1px; -fx-border-radius: 6px; -fx-cursor: hand;" text="Annuler" />
            <Button mnemonicParsing="false" onAction="#handleAdd" style="-fx-background-color: #10B981; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 10px 20px; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(16, 185, 129, 0.2), 6, 0, 0, 2);" text="Ajouter le lieu" />
        </children>
    </HBox>

</VBox>