<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="32.0" styleClass="content-container" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">

    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="36.0" />
    </padding>
    <children>

        <HBox alignment="CENTER_LEFT" spacing="16.0">
            <children>
                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label styleClass="dashboard-subtitle" text="LOGISTIQUE &amp; PARTENAIRES" />
                        <Label fx:id="titleLabel" styleClass="dashboard-title" text="Prestataires" />
                    </children>
                </VBox>
                <Button mnemonicParsing="false" onAction="#handleAjoutPrestataire" styleClass="btn-create-primary" text="➕  Ajouter un prestataire" />
            </children>
        </HBox>

        <StackPane VBox.vgrow="ALWAYS">
            <children>

                <VBox fx:id="emptyStateBox" alignment="CENTER" minHeight="200.0" spacing="10.0" styleClass="empty-state-box">
                    <padding>
                        <Insets bottom="28.0" left="24.0" right="24.0" top="28.0" />
                    </padding>
                    <children>
                        <Label style="-fx-font-size: 32px;" styleClass="empty-state-icon" text="🤝" />
                        <Label styleClass="empty-state-title" text="Aucun prestataire enregistré" />
                        <Label alignment="CENTER" maxWidth="420.0" styleClass="empty-state-hint" text="Enregistrez vos partenaires (stands de nourriture, sécurité, technique) pour gérer la logistique de l'événement." wrapText="true" />
                        <HBox alignment="CENTER" spacing="12.0">
                            <VBox.margin>
                                <Insets top="4.0" />
                            </VBox.margin>
                            <children>
                                <Button mnemonicParsing="false" onAction="#handleAjoutPrestataire" styleClass="big-action-btn, btn-pink-outline" text="Nouveau Prestataire" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <VBox fx:id="carouselContainer" spacing="24.0" visible="false" managed="false">
                    <children>
                        <Label text="Vos prestataires configurés" style="-fx-font-family: 'Segoe UI', sans-serif; -fx-font-weight: bold; -fx-font-size: 15px; -fx-text-fill: #111827;" />

                        <HBox alignment="CENTER" spacing="12.0" fx:id="controlsBox">
                            <children>
                                <Button fx:id="prevBtn" mnemonicParsing="false" onAction="#handleCarouselPrev" text="◀"
                                        style="-fx-background-color: #EFF6FF; -fx-text-fill: #2563EB; -fx-font-weight: bold; -fx-background-radius: 50%; -fx-min-width: 40px; -fx-min-height: 40px; -fx-max-width: 40px; -fx-max-height: 40px; -fx-cursor: hand; -fx-border-color: #BFDBFE; -fx-border-width: 1px; -fx-border-radius: 50%;" />

                                <ScrollPane fx:id="carouselScrollPane" HBox.hgrow="ALWAYS" vbarPolicy="NEVER" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
                                    <content>
                                        <HBox fx:id="cardContainer" spacing="20.0" style="-fx-padding: 10px 5px; -fx-alignment: center-left;" />
                                    </content>
                                </ScrollPane>

                                <Button fx:id="nextBtn" mnemonicParsing="false" onAction="#handleCarouselNext" text="▶"
                                        style="-fx-background-color: #EFF6FF; -fx-text-fill: #2563EB; -fx-font-weight: bold; -fx-background-radius: 50%; -fx-min-width: 40px; -fx-min-height: 40px; -fx-max-width: 40px; -fx-max-height: 40px; -fx-cursor: hand; -fx-border-color: #BFDBFE; -fx-border-width: 1px; -fx-border-radius: 50%;" />
                            </children>
                        </HBox>

                        <HBox alignment="CENTER" spacing="12.0">
                            <children>
                                <Label fx:id="dot1" text="●" style="-fx-text-fill: #2563EB; -fx-font-size: 16px;" />
                                <Label fx:id="dot2" text="●" style="-fx-text-fill: #10B981; -fx-font-size: 16px;" />
                                <Label fx:id="dot3" text="●" style="-fx-text-fill: #F59E0B; -fx-font-size: 16px;" />
                                <Label fx:id="dot4" text="●" style="-fx-text-fill: #EF4444; -fx-font-size: 16px;" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

            </children>
        </StackPane>
    </children>
</VBox>