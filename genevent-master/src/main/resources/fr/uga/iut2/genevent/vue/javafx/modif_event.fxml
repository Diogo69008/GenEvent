<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox stylesheets="@styles.css" prefHeight="650.0" prefWidth="550.0" spacing="20.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <HBox alignment="CENTER_LEFT">
        <children>
            <Label text="✏️ Modifier l'évènement" style="-fx-font-family: 'Segoe UI', sans-serif; -fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
        </children>
    </HBox>

    <Separator style="-fx-background-color: #E5E7EB; -fx-padding: 0;" />

    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" vbarPolicy="AS_NEEDED" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
        <VBox spacing="18.0" fillWidth="true">

            <VBox spacing="6.0">
                <Label text="Nom de l'évènement*" style="-fx-font-weight: bold; -fx-text-fill: #374151; -fx-font-size: 12px;" />
                <TextField fx:id="tfNom" onKeyTyped="#verifyField" maxWidth="1.7976931348623157E308" promptText="Ex: Festival Summer 2026" disable="true" />
            </VBox>

            <VBox spacing="6.0">
                <Label text="Date de début*" style="-fx-font-weight: bold; -fx-text-fill: #374151; -fx-font-size: 12px;" />
                <DatePicker fx:id="dpDeb" maxWidth="1.7976931348623157E308" />
            </VBox>

            <VBox spacing="6.0">
                <Label text="Date de fin*" style="-fx-font-weight: bold; -fx-text-fill: #374151; -fx-font-size: 12px;" />
                <DatePicker fx:id="dpFin" maxWidth="1.7976931348623157E308" />
            </VBox>

            <VBox spacing="6.0">
                <Label text="Lieu" style="-fx-font-weight: bold; -fx-text-fill: #374151; -fx-font-size: 12px;" />
                <ComboBox fx:id="cbLieu" maxWidth="1.7976931348623157E308" promptText="Sélectionner un lieu" />
                <Button fx:id="btnLieu" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleNewLieu" text="+ Nouveau lieu" style="-fx-background-color: #E0F2FE; -fx-text-fill: #2563EB; -fx-font-weight: bold; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 8px 12px; -fx-cursor: hand; -fx-font-family: 'Segoe UI', sans-serif; -fx-font-size: 12px;" />
                <Label fx:id="labErr" style="-fx-font-family: 'Segoe UI', sans-serif; -fx-font-size: 11px; -fx-text-fill: #EF4444;" />
            </VBox>

            <VBox spacing="6.0">
                <Label text="Budget*" style="-fx-font-weight: bold; -fx-text-fill: #374151; -fx-font-size: 12px;" />
                <TextField fx:id="tfBud" onKeyTyped="#verifyField" promptText="Montant en €" maxWidth="1.7976931348623157E308" />
            </VBox>

            <VBox spacing="6.0">
                <Label text="Prix du billet" style="-fx-font-weight: bold; -fx-text-fill: #374151; -fx-font-size: 12px;" />
                <Label fx:id="labelPrixBillet" maxWidth="1.7976931348623157E308" />
            </VBox>

            <VBox spacing="6.0">
                <Label text="Artistes liés" style="-fx-font-weight: bold; -fx-text-fill: #374151; -fx-font-size: 12px;" />
                <ScrollPane fitToWidth="true" prefHeight="120.0" style="-fx-background-color: #F9FAFB; -fx-background: #F9FAFB; -fx-border-color: #E5E7EB;">
                    <content>
                        <VBox fx:id="vboxArtistes" spacing="6.0" fillWidth="true" style="-fx-padding: 10px;" />
                    </content>
                </ScrollPane>
            </VBox>

            <VBox spacing="6.0">
                <Label text="Ajouter un artiste" style="-fx-font-weight: bold; -fx-text-fill: #374151; -fx-font-size: 12px;" />
                <ComboBox fx:id="cbArtiste" maxWidth="1.7976931348623157E308" promptText="Sélectionner un artiste" />
                <Button onAction="#onAjoutArtiste" fx:id="btnValiderArtiste" maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="Valider" style="-fx-background-color: #EEF2FF; -fx-text-fill: #4F46E5; -fx-font-weight: bold; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 8px 12px; -fx-cursor: hand; -fx-font-family: 'Segoe UI', sans-serif; -fx-font-size: 12px;" />
            </VBox>

            <VBox spacing="6.0">
                <Label text="Prestataires liés" style="-fx-font-weight: bold; -fx-text-fill: #374151; -fx-font-size: 12px;" />
                <ScrollPane fitToWidth="true" prefHeight="120.0" style="-fx-background-color: #F9FAFB; -fx-background: #F9FAFB; -fx-border-color: #E5E7EB;">
                    <content>
                        <VBox fx:id="vboxPrestataires" spacing="6.0" fillWidth="true" style="-fx-padding: 10px;" />
                    </content>
                </ScrollPane>
            </VBox>

            <VBox spacing="6.0">
                <Label text="Ajouter un prestataire" style="-fx-font-weight: bold; -fx-text-fill: #374151; -fx-font-size: 12px;" />
                <ComboBox fx:id="cbPrestataire" maxWidth="1.7976931348623157E308" promptText="Sélectionner un prestataire" />
                <Button onAction="#onAjoutPresta" fx:id="btnValiderPrestataire" maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="Valider" style="-fx-background-color: #EEF2FF; -fx-text-fill: #4F46E5; -fx-font-weight: bold; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 8px 12px; -fx-cursor: hand; -fx-font-family: 'Segoe UI', sans-serif; -fx-font-size: 12px;" />
            </VBox>

        </VBox>
    </ScrollPane>

    <Separator style="-fx-background-color: #E5E7EB; -fx-padding: 0;" />

    <HBox alignment="CENTER_RIGHT" spacing="12.0">
        <children>
            <Button mnemonicParsing="false" onAction="#onResetClick" style="-fx-background-color: #F3F4F6; -fx-text-fill: #6B7280; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 10px 20px; -fx-border-color: #D1D5DB; -fx-border-width: 1px; -fx-border-radius: 6px; -fx-cursor: hand; -fx-font-family: 'Segoe UI', sans-serif; -fx-font-size: 12px;" text="Réinitialiser" />
            <Button mnemonicParsing="false" onAction="#onBackClick" style="-fx-background-color: #F3F4F6; -fx-text-fill: #6B7280; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 10px 20px; -fx-border-color: #D1D5DB; -fx-border-width: 1px; -fx-border-radius: 6px; -fx-cursor: hand; -fx-font-family: 'Segoe UI', sans-serif; -fx-font-size: 12px;" text="Annuler" />
            <Button mnemonicParsing="false" fx:id="btnModif" onAction="#handleModifierClique" style="-fx-background-color: #10B981; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 10px 20px; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(16, 185, 129, 0.2), 6, 0, 0, 2); -fx-font-family: 'Segoe UI', sans-serif; -fx-font-size: 12px;" text="Mettre à jour" />
        </children>
    </HBox>
</VBox>